# Database (local docker-compose default shown; point at Neon connection string in prod)
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio

# GitHub sync
GITHUB_USERNAME=varundutia
GITHUB_TOKEN=

# Embedding provider: fastembed (default, local, no key) | openai | voyage
EMBEDDING_PROVIDER=fastembed
EMBEDDING_DIMENSIONS=384
OPENAI_API_KEY=
VOYAGE_API_KEY=

# LLM provider: stub (default, no live calls) | anthropic | openai
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_LLM_MODEL=gpt-4o-mini

# Admin auth
ADMIN_PASSWORD_HASH=
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# File storage (local disk path for uploaded originals)
STORAGE_DIR=./storage
