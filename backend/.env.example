# Database (local docker-compose default shown; point at Neon connection string in prod)
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio

# GitHub sync
GITHUB_USERNAME=varundutia
GITHUB_TOKEN=

# Embedding provider: fastembed (default, local, no key) | openai | voyage
EMBEDDING_PROVIDER=fastembed
EMBEDDING_DIMENSIONS=384
OPENAI_API_KEY=
VOYAGE_API_KEY=

# LLM provider: stub (default, no live calls) | anthropic | openai | gemini
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_LLM_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=512

# CORS
FRONTEND_ORIGIN=http://localhost:3000
# Optional comma-separated list for production + preview frontends.
FRONTEND_ORIGINS=https://varundutia.live,https://www.varundutia.live
FRONTEND_ORIGIN_REGEX=https://.*\.vercel\.app

# File storage (local disk path for uploaded originals)
STORAGE_DIR=./storage
